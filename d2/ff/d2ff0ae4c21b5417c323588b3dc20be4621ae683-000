# 12 October 2026: exact ease identification of one animated channel, moved from the R04 laboratory
# (docs/research/R04-lab/EaseFit.py, verified there on 324 synthetic moves and through H.264) into the engine.
# Model: y(t) = a + b * E(clip((t - t0) / d, 0, 1)), E an exact GSAP 3.14.2 ease sampled from the renderer's own library
# (datasets/eases/eases-gsap-3.14.2.json, regenerated by Scripts/SampleGsapEases.mjs) or a free CSS cubic-bezier.
# a and b are solved in closed form for every (t0, d) (variable projection); t0 and d by grid then Nelder-Mead.
# Model choice by BIC; candidates within bic_tie of the best are reported as ties.
# Added in the engine (R04 decisions 3 and 4): the window is bounded to the shot plus a margin, a best window outside
# that bound is flagged "linear_segment"; every result carries its confidence (amplitude over measurement noise).
# FR : identification de l'ease exacte d'un canal anime, fenetre bornee au plan et confiance, reprise du laboratoire R04.
from __future__ import annotations

import json
import math
from functools import lru_cache
from pathlib import Path

import numpy as np

from .. import settings


def cfg_default() -> dict:
    return settings.get("analysis.easefit")


class EaseLibrary:
    """Exact ease curves sampled from the renderer."""

    def __init__(self, path: str | Path | None = None, names: list[str] | None = None):
        path = Path(path) if path else settings.REPO / cfg_default()["library"]
        data = json.loads(Path(path).read_text(encoding="utf-8"))
        self.grid = np.asarray(data["grid"], dtype=np.float64)
        wanted = names or list(data["eases"].keys())
        self.curves = {name: np.asarray(data["eases"][name], dtype=np.float64) for name in wanted}
        self.version = data.get("gsap")
        self.path = str(path)

    def names(self) -> list[str]:
        return list(self.curves.keys())

    def evaluate(self, name: str, u) -> np.ndarray:
        u = np.clip(u, 0.0, 1.0)
        return np.interp(u, self.grid, self.curves[name])


@lru_cache(maxsize=1)
def default_library() -> EaseLibrary:
    return EaseLibrary()


def cubic_bezier(u, x1, y1, x2, y2, iterations: int = 40) -> np.ndarray:
    """CSS cubic-bezier(x1, y1, x2, y2) at progress u, by bisection on the curve parameter."""
    u = np.clip(np.asarray(u, dtype=np.float64), 0.0, 1.0)
    lo = np.zeros_like(u)
    hi = np.ones_like(u)
    for _ in range(iterations):
        s = 0.5 * (lo + hi)
        x = 3 * (1 - s) ** 2 * s * x1 + 3 * (1 - s) * s ** 2 * x2 + s ** 3
        below = x < u
        lo = np.where(below, s, lo)
        hi = np.where(below, hi, s)
    s = 0.5 * (lo + hi)
    return 3 * (1 - s) ** 2 * s * y1 + 3 * (1 - s) * s ** 2 * y2 + s ** 3


def back_out(u, k: float) -> np.ndarray:
    """GSAP back.out(k) closed form, used to refine the overshoot continuously."""
    v = 1.0 - np.clip(u, 0.0, 1.0)
    return 1.0 - v * v * ((k + 1.0) * v - k)


def nelder_mead(f, x0, step, iterations: int = 400, tolerance: float = 1e-10):
    """Plain Nelder-Mead minimiser (numpy only, identical to the laboratory version)."""
    n = len(x0)
    simplex = [np.asarray(x0, dtype=np.float64)]
    for i in range(n):
        point = np.array(x0, dtype=np.float64)
        point[i] += step[i]
        simplex.append(point)
    values = [f(p) for p in simplex]
    for _ in range(iterations):
        order = np.argsort(values)
        simplex = [simplex[i] for i in order]
        values = [values[i] for i in order]
        if abs(values[-1] - values[0]) <= tolerance * (abs(values[0]) + 1e-30):
            break
        centroid = np.mean(simplex[:-1], axis=0)
        reflected = centroid + (centroid - simplex[-1])
        fr = f(reflected)
        if fr < values[0]:
            expanded = centroid + 2.0 * (centroid - simplex[-1])
            fe = f(expanded)
            if fe < fr:
                simplex[-1], values[-1] = expanded, fe
            else:
                simplex[-1], values[-1] = reflected, fr
        elif fr < values[-2]:
            simplex[-1], values[-1] = reflected, fr
        else:
            contracted = centroid + 0.5 * (simplex[-1] - centroid)
            fc = f(contracted)
            if fc < values[-1]:
                simplex[-1], values[-1] = contracted, fc
            else:
                best = simplex[0]
                simplex = [best + 0.5 * (p - best) for p in simplex]
                values = [f(p) for p in simplex]
    i = int(np.argmin(values))
    return simplex[i], values[i]


def solve_linear(x, y):
    """Least squares y = a + b x; returns a, b, sse (rows of x may be stacked)."""
    xm = x.mean(axis=-1, keepdims=True)
    ym = y.mean()
    dx = x - xm
    var = (dx * dx).sum(axis=-1)
    cov = (dx * (y - ym)).sum(axis=-1)
    b = np.where(var > 1e-15, cov / np.maximum(var, 1e-15), 0.0)
    a = ym - b * xm[..., 0]
    resid = y - (a[..., None] + b[..., None] * x)
    return a, b, (resid * resid).sum(axis=-1)


def noise_sigma(y) -> float:
    """Measurement noise of a channel: MAD of the second difference, scaled to one sample (robust to the move)."""
    y = np.asarray(y, dtype=np.float64)
    if len(y) < 4:
        return 0.0
    d2 = np.diff(y, 2)
    return float(1.4826 * np.median(np.abs(d2 - np.median(d2))) / math.sqrt(6.0))


def motion_support(t, y):
    """First and last instants where the channel visibly moves: step smoothed over 5 frames, threshold the larger of
    5 % of the peak and 4 noise sigmas (R04 section 5.3 correction)."""
    raw = np.diff(y)
    if np.abs(raw).max() <= 0:
        return t[0], t[-1]
    k = min(5, len(raw))
    v = np.abs(np.convolve(raw, np.ones(k) / k, mode="same"))
    noise = 1.4826 * np.median(np.abs(raw - np.median(raw))) / math.sqrt(k)
    # 12 October 2026: on a smooth, nearly noiseless channel the MAD of the raw steps measures the move itself and the
    # support collapsed (a sine.inOut segment came back as 'none'); the second-difference noise caps it.
    noise = min(noise, noise_sigma(y) * math.sqrt(2.0) / math.sqrt(k))
    idx = np.nonzero(v > max(0.05 * v.max(), 4.0 * noise))[0]
    if len(idx) == 0:
        idx = np.array([int(np.argmax(v))])
    return t[idx[0]], t[min(idx[-1] + 1, len(t) - 1)]


def fit_window(t, y, shape, t0_range, d_range, grid: int = 24, refine: bool = True, strict: bool = False) -> dict:
    """Fit a, b, t0, d for one shape function shape(u)."""
    t0s = np.linspace(t0_range[0], t0_range[1], grid)
    ds = np.geomspace(max(d_range[0], 1e-3), max(d_range[1], d_range[0] * 1.0001, 1.1e-3), grid)
    T0, D = np.meshgrid(t0s, ds, indexing="ij")
    T0, D = T0.ravel(), D.ravel()
    u = np.clip((t[None, :] - T0[:, None]) / D[:, None], 0.0, 1.0)
    a, b, sse = solve_linear(shape(u), y)
    i = int(np.argmin(sse))
    best = {"t0": float(T0[i]), "d": float(D[i]), "a": float(a[i]), "b": float(b[i]), "sse": float(sse[i])}
    if refine:
        lo0, hi0 = t0_range
        dmin, dmax = d_range

        def cost(p):
            if p[1] <= 1e-3 or p[1] < 0.5 * dmin or p[1] > 2.0 * dmax or p[0] < lo0 - (hi0 - lo0) or p[0] > hi0 + (hi0 - lo0):
                return 1e30
            # 12 October 2026: a bounded fit (window held inside the shot) must not escape its ranges while refining.
            if strict and (p[0] < lo0 or p[0] > hi0 or p[1] < dmin or p[1] > dmax):
                return 1e30
            uu = np.clip((t - p[0]) / p[1], 0.0, 1.0)
            return float(solve_linear(shape(uu)[None, :], y)[2][0])

        step = [max((t0_range[1] - t0_range[0]) / grid, 1e-3), max(best["d"] * 0.1, 1e-3)]
        p, sse_r = nelder_mead(cost, [best["t0"], best["d"]], step, iterations=300)
        if sse_r < best["sse"]:
            uu = np.clip((t - p[0]) / p[1], 0.0, 1.0)
            aa, bb, _ = solve_linear(shape(uu)[None, :], y)
            best = {"t0": float(p[0]), "d": float(p[1]), "a": float(aa[0]), "b": float(bb[0]), "sse": float(sse_r)}
    return best


def default_ranges(t, y):
    first, last = motion_support(t, y)
    span = max(last - first, (t[1] - t[0]) * 2)
    return (first - 2.0 * span, first + 0.25 * span), (0.5 * span, 3.5 * span)


def bounded_ranges(t, y, bounds, margin):
    """Search ranges clipped to the shot: the move starts no earlier than bounds[0]-margin and ends no later than
    bounds[1]+margin."""
    (t0lo, t0hi), (dlo, dhi) = default_ranges(t, y)
    lo, hi = bounds[0] - margin, bounds[1] + margin
    t0lo = max(t0lo, lo)
    t0hi = max(min(t0hi, hi - 1e-3), t0lo)
    dhi = max(min(dhi, hi - t0lo), 1e-3)
    dlo = min(dlo, dhi)
    return (t0lo, t0hi), (dlo, dhi)


def bic(sse, n, k):
    return n * math.log(max(sse, 1e-300) / n) + k * math.log(n)


def fit_library(t, y, library: EaseLibrary, names=None, top_refine: int = 10, ranges=None, grid: int = 24) -> list[dict]:
    """Rank every library ease on one trajectory. Grid for all, Nelder-Mead refinement for the best few."""
    t = np.asarray(t, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    t0_range, d_range = ranges or default_ranges(t, y)
    rows = []
    strict = ranges is not None
    for name in names or library.names():
        row = fit_window(t, y, lambda u, name=name: library.evaluate(name, u), t0_range, d_range, grid=grid, refine=False)
        row["name"] = name
        rows.append(row)
    rows.sort(key=lambda r: r["sse"])
    for row in rows[:top_refine]:
        row.update(fit_window(t, y, lambda u, name=row["name"]: library.evaluate(name, u), t0_range, d_range, grid=grid,
                              refine=True, strict=strict))
    rows.sort(key=lambda r: r["sse"])
    n = len(t)
    for row in rows:
        row["rms"] = math.sqrt(row["sse"] / n)
        row["bic"] = bic(row["sse"], n, 4)
    return rows


def bezier_basis(u, x1, x2, iterations: int = 40):
    """Bernstein terms of a CSS cubic-bezier: value = a + c1*B1 + c2*B2 + c3*B3, linear in (a, c1, c2, c3)."""
    u = np.clip(np.asarray(u, dtype=np.float64), 0.0, 1.0)
    lo = np.zeros_like(u)
    hi = np.ones_like(u)
    for _ in range(iterations):
        s = 0.5 * (lo + hi)
        x = 3 * (1 - s) ** 2 * s * x1 + 3 * (1 - s) * s ** 2 * x2 + s ** 3
        below = x < u
        lo = np.where(below, s, lo)
        hi = np.where(below, hi, s)
    s = 0.5 * (lo + hi)
    return np.stack([np.ones_like(s), 3 * (1 - s) ** 2 * s, 3 * (1 - s) * s ** 2, s ** 3], axis=-1)


def _bezier_lsq(t, y, x1, x2, t0, d):
    u = np.clip((t - t0) / d, 0.0, 1.0)
    A = bezier_basis(u, x1, x2)
    coef, *_ = np.linalg.lstsq(A, y, rcond=None)
    resid = y - A @ coef
    return coef, float(resid @ resid)


def fit_bezier(t, y, t0_hint, d_hint, grid: int = 11) -> dict:
    """Free CSS cubic-bezier fit (x1, x2, t0, d nonlinear; a, b, y1, y2 linear at every step)."""
    t = np.asarray(t, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    xs = np.linspace(0.0, 1.0, grid)
    best = (float("inf"), None)
    first, last = motion_support(t, y)
    frame = t[1] - t[0]
    windows = []
    for c0, cd in ((t0_hint, d_hint), (first - frame, last - first + 2 * frame)):
        for k0 in (-0.1, 0.0, 0.1):
            for kd in (0.85, 1.0, 1.2):
                windows.append((c0 + k0 * cd, cd * kd))
    for t0, d in windows:
        if d <= 1e-3:
            continue
        for x1 in xs:
            for x2 in xs:
                _, sse = _bezier_lsq(t, y, x1, x2, t0, d)
                if sse < best[0]:
                    best = (sse, (x1, x2, t0, d))

    def cost(p):
        x1, x2, t0, d = p
        if d <= 1e-3 or not (0.0 <= x1 <= 1.0) or not (0.0 <= x2 <= 1.0):
            return 1e30
        return _bezier_lsq(t, y, x1, x2, t0, d)[1]

    p, _ = nelder_mead(cost, list(best[1]), [0.05, 0.05, 0.02 * d_hint, 0.05 * d_hint], iterations=800)
    x1, x2, t0, d = p
    coef, sse = _bezier_lsq(t, y, x1, x2, t0, d)
    a, c1, c2, c3 = coef
    b = c3 if abs(c3) > 1e-12 else 1e-12
    n = len(t)
    return {"name": "cubic-bezier", "bezier": [float(x1), float(c1 / b), float(x2), float(c2 / b)], "t0": float(t0),
            "d": float(d), "a": float(a), "b": float(b), "sse": float(sse), "rms": math.sqrt(sse / n), "bic": bic(sse, n, 8)}


def refine_back(t, y, ranges=None) -> dict:
    """Continuous back.out(k) overshoot by golden section."""
    t = np.asarray(t, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    t0_range, d_range = ranges or default_ranges(t, y)

    def sse_for(k):
        return fit_window(t, y, lambda u: back_out(u, k), t0_range, d_range, refine=True, strict=ranges is not None)

    lo, hi = 0.1, 5.0
    g = (math.sqrt(5) - 1) / 2
    c, d = hi - g * (hi - lo), lo + g * (hi - lo)
    fc, fd = sse_for(c), sse_for(d)
    for _ in range(25):
        if fc["sse"] < fd["sse"]:
            hi, d, fd = d, c, fc
            c = hi - g * (hi - lo)
            fc = sse_for(c)
        else:
            lo, c, fc = c, d, fd
            d = lo + g * (hi - lo)
            fd = sse_for(d)
    k = c if fc["sse"] < fd["sse"] else d
    res = fc if fc["sse"] < fd["sse"] else fd
    n = len(t)
    res.update({"name": f"back.out({k:.3f})", "k": k, "rms": math.sqrt(res["sse"] / n), "bic": bic(res["sse"], n, 5)})
    return res


def identify(t, y, library: EaseLibrary | None = None, with_bezier: bool = True, names=None, ranges=None,
             cfg: dict | None = None) -> dict:
    """Full decision for one channel: ranked library, optional free bezier, BIC choice, ties."""
    cfg = cfg or cfg_default()
    library = library or default_library()
    rows = fit_library(t, y, library, names=names, top_refine=cfg["top_refine"], ranges=ranges, grid=cfg["grid"])
    best = rows[0]
    decision = dict(best, family="library")
    candidates = [decision]
    if best["name"].startswith("back.out"):
        refined = refine_back(t, y, ranges)
        refined["family"] = "back"
        candidates.append(refined)
    if with_bezier:
        bez = fit_bezier(t, y, best["t0"], best["d"])
        bez["family"] = "bezier"
        candidates.append(bez)
    chosen = candidates[0]
    for r in candidates[1:]:
        margin = cfg["bic_bezier_margin"] if r["family"] == "bezier" else cfg["bic_back_margin"]
        if r["bic"] < chosen["bic"] - margin:
            chosen = r
    ties = [r["name"] for r in rows if r["bic"] - rows[0]["bic"] < cfg["bic_tie"]]
    return {"chosen": chosen, "library_best": best, "ties": ties,
            "ranking": [(r["name"], r["rms"], r["bic"]) for r in rows[:8]]}


def predict(t, row: dict, library: EaseLibrary | None = None) -> np.ndarray:
    """Evaluate a fitted row at times t."""
    t = np.asarray(t, dtype=np.float64)
    u = np.clip((t - row["t0"]) / row["d"], 0.0, 1.0)
    if row.get("name") == "cubic-bezier":
        e = cubic_bezier(u, *row["bezier"])
    elif "k" in row:
        e = back_out(u, row["k"])
    else:
        e = (library or default_library()).evaluate(row["name"], u)
    return row["a"] + row["b"] * e


def segments(t, y, rest_ratio: float = 0.02, min_rest: int = 4, pad: int = 3):
    """Split a channel into moves separated by rests (speed under rest_ratio of the peak for min_rest frames)."""
    v = np.abs(np.diff(y))
    if len(v) == 0 or v.max() <= 0:
        return []
    moving = v > rest_ratio * v.max()
    out, start, rest = [], None, 0
    for i, m in enumerate(moving):
        if m:
            if start is None:
                start = i
            rest = 0
        elif start is not None:
            rest += 1
            if rest >= min_rest:
                out.append((max(0, start - pad), min(len(t) - 1, i - rest + 1 + pad)))
                start, rest = None, 0
    if start is not None:
        out.append((max(0, start - pad), len(t) - 1))
    return out


def identify_channel(t, y, bounds: tuple[float, float] | None = None, library: EaseLibrary | None = None,
                     cfg: dict | None = None, with_bezier: bool | None = None) -> dict:
    """Engine entry point (R04 decisions 3 and 4). Fits the free window first; when its window leaves the shot plus
    margin, the move is flagged 'linear_segment' and refitted inside the bound. Returns a tween-ready dict:
    start, duration, from, to, ease, rms (value unit), rms_rel (share of the amplitude), ties, confidence, snr."""
    cfg = cfg or cfg_default()
    library = library or default_library()
    t = np.asarray(t, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    wb = cfg["with_bezier"] if with_bezier is None else with_bezier
    res = identify(t, y, library, with_bezier=wb, cfg=cfg)
    flag = None
    if bounds is not None:
        margin = cfg["window_margin_s"]
        c = res["chosen"]
        if c["t0"] < bounds[0] - margin or c["t0"] + c["d"] > bounds[1] + margin:
            flag = "linear_segment"
            res = identify(t, y, library, with_bezier=wb, ranges=bounded_ranges(t, y, bounds, margin), cfg=cfg)
    c = res["chosen"]
    fitted = predict(t, c, library)
    amplitude = float(np.ptp(fitted)) if len(fitted) else 0.0
    noise = noise_sigma(y)
    snr = amplitude / max(noise, 1e-9)
    ease = c["name"]
    if ease == "cubic-bezier":
        ease = "cubic-bezier({:.3f},{:.3f},{:.3f},{:.3f})".format(*c["bezier"])
    return {"start": round(c["t0"], 4), "duration": round(c["d"], 4), "from": round(c["a"], 4),
            "to": round(c["a"] + c["b"], 4), "ease": ease, "rms": round(c["rms"], 4),
            "rms_rel": round(c["rms"] / max(amplitude, 1e-9), 4), "amplitude": round(amplitude, 4),
            "ties": res["ties"][:6], "snr": round(snr, 1),
            "confidence": "high" if snr >= cfg["snr_high"] and len(res["ties"]) <= 3 else "low",
            "flag": flag, "library": library.version}


def selftest() -> dict:
    """Both directions on numbers: a power3.out move is recovered (green); a power1.in move is not called power3.out
    and a forced wrong ease leaves a large residual (red)."""
    lib = default_library()
    fps = 60.0
    t = np.arange(0, 1.2, 1 / fps)
    truth = 100 + 400 * lib.evaluate("power3.out", (t - 0.2) / 0.6)
    rng = np.random.default_rng(7)
    y = truth + rng.normal(0, 0.3, len(t))
    good = identify_channel(t, y, bounds=(0.0, 1.2))
    wrong = 100 + 400 * lib.evaluate("power1.in", (t - 0.2) / 0.6) + rng.normal(0, 0.3, len(t))
    bad = identify_channel(t, wrong, bounds=(0.0, 1.2))
    forced = fit_library(t, wrong, lib, names=["power3.out"])[0]
    return {"recovers_power3_out": good["ease"] == "power3.out" and abs(good["start"] - 0.2) < 1 / fps
            and abs(good["duration"] - 0.6) < 2 / fps,
            "rejects_wrong": bad["ease"] != "power3.out",
            "forced_wrong_rms_rel": round(forced["rms"] / 400, 4), "good": good, "bad": bad}


def reportable(tween: dict, cfg: dict | None = None) -> bool:
    """12 October 2026: gate before a tween enters a bible. A move explained worse than report_max_rms_rel of its
    amplitude, or measured under report_min_snr, is noise; elastic, bounce and back shapes need report_shaped_min_snr
    because a noisy track is easily 'explained' by an oscillating ease. FR : filtre avant d'ecrire une courbe."""
    cfg = cfg or cfg_default()
    if tween["rms_rel"] > cfg["report_max_rms_rel"] or tween["snr"] < cfg["report_min_snr"]:
        return False
    shaped = any(k in tween["ease"] for k in ("elastic", "bounce", "back"))
    return not shaped or tween["snr"] >= cfg["report_shaped_min_snr"]
