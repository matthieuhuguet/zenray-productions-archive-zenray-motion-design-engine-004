            L.append(f"Appariement de police non conclu : {fm['error']}.")
    else:
        L.append("Aucune ligne de texte mesurable dans les plans carte texte ou graphique.")
    L += ["", "## Mouvements et courbes", ""]
    if S["eases"]:
        L.append("Courbes identifiées contre la table exacte de GSAP 3.14.2 (une courbe n'est gardée que si elle explique le "
                 "mouvement à 6 % de l'amplitude près et que le mouvement dépasse dix fois le bruit de mesure) :")
        L += ["", "| Ease | Occurrences |", "|---|---|"] + [f"| `{k}` | {v} |" for k, v in list(S["eases"].items())[:14]]
        if S.get("element_move_median_s"):
            L += ["", f"Un mouvement d'élément dure {fr_num(S['element_move_median_s'])} s en médiane."]
    else:
        L.append("Aucune courbe n'a passé le filtre de qualité ; les mouvements de cette référence sont trop bruités ou trop "
                 "petits pour une identification fiable à cette résolution d'analyse.")
    L += ["", "Mouvement global de l'image (similarité chaînée image après image ; sur un fond uni, il suit le calque dominant) :", "",
          "| Mouvement | Plans |", "|---|---|"] + [f"| {k} | {v} |" for k, v in sorted(S["camera_kinds"].items(), key=lambda kv: -kv[1])]
    L += ["", "## Transitions", "", "| Transition d'entrée | Plans |", "|---|---|"]
    L += [f"| {k} | {v} |" for k, v in S["transitions"].items()]
    D = S["three_d"]
    L += ["", "## Usage de la 3D", "",
          f"Les plaques (rendu 3D ou prise de vue) occupent {fr_num(100 * D['plate_share'], 1)} % du temps, dont {D['plate_3d_shots']} "
          "plans que la sonde géométrique classe comme 3D (perspective, parallaxe, scène rigide, apparence changeante ou mouvement "
          "complexe). La sonde répond juste quand elle dit 3D, mais elle manque les objets 3D qui glissent comme un calque (R04, "
          "section 10) ; les descriptions plan par plan corrigent ce point à l'œil.", "", "| Classe de la sonde | Plans |", "|---|---|"]
    L += [f"| {camera.CLASS_FR.get(k, k)} | {v} |" for k, v in sorted(D["probe_classes"].items(), key=lambda kv: -kv[1])]
    L += ["", "## Son", ""]
    if snd:
        evs = b.get("sound_events") or []
        kinds = {}
        for e in evs:
            kinds[e["kind"]] = kinds.get(e["kind"], 0) + 1
        L.append(f"Sonie intégrée {fr_num(snd.get('loudness_lufs'), 1)} LUFS, centroïde spectral médian {fr_num(snd.get('centroid_hz'), 0)} Hz, "
                 f"part harmonique {fr_num(100 * (snd.get('harmonic_share') or 0), 0)} %. Le détecteur d'attaques relève {len(evs)} événements "
                 f"(" + ", ".join(f"{k} {v}" for k, v in sorted(kinds.items(), key=lambda kv: -kv[1])) + f") et le détecteur de houles "
                 f"{len(snd.get('swells', []))} montées ou souffles longs.")
        main = [e for e in evs if e["id"] in set(snd.get("main_events", []))]
        if main:
            L += ["", "Événements principaux (les plus forts) :", "", "| Instant | Nature | Crête |", "|---|---|---|"]
            L += [f"| {fr_num(e['t'])} s | {e['kind']} | {fr_num(e['peak_db'], 1)} dB |" for e in sorted(main, key=lambda e: e["t"])]
        if snd.get("swells"):
            L += ["", "Houles : " + ", ".join(f"{fr_num(w['t'])} s (montée {fr_num(w['rise_s'])} s)" for w in snd["swells"][:16]) + "."]
        L += ["", "## Musique", "",
              f"Tempo estimé {fr_num(snd.get('tempo_bpm'), 1)} BPM, {snd.get('beats')} temps détectés, régularité de la grille "
              f"{fr_num(snd.get('beat_regularity'), 3)} (écart type relatif des intervalles, 0 pour une grille parfaite). La musique "
              "ne se reprend jamais note à note : seuls le tempo, la grille, les sections, l'énergie et la production servent.", "",
              "| Section | Début | Fin | Niveau médian |", "|---|---|---|---|"]
        L += [f"| {i + 1} | {fr_num(s['start'])} s | {fr_num(s['end'])} s | {fr_num(s['level_db'], 1)} dB |" for i, s in enumerate(snd.get("sections", []))]
    else:
        L.append("La référence n'a pas de piste sonore.")
    L += ["", "## Plans", "", "| Plan | Début | Durée | Famille | Description |", "|---|---|---|---|---|"]
    for s in b["shots"]:
        L.append(f"| {s['id']} | {fr_num(s['start'])} s | {fr_num(s['duration'])} s | {FAMILY_FR[s['family']]} | "
                 f"{description(s, desc).replace('|', '/')} |")
    L += ["", f"Paramètres : `settings.json`, sections `analysis.bible`, `analysis.camera`, `analysis.easefit`, `analysis.sound` ({b['date']}).", ""]
    text = "\n".join(L)
    return text.replace("—", ",").replace("–", ",")


def write_markdown(slug: str) -> Path:
    b = json.loads((REFERENCES / slug / "bible.json").read_text(encoding="utf-8"))
    target = REFERENCES / slug / "bible.md"
    target.write_text(render_markdown(b, load_descriptions(slug)), encoding="utf-8")
    return target
