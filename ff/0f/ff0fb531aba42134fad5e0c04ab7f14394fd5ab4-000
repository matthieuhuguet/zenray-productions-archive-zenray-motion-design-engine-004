def load_descriptions(slug: str) -> dict:
    """The eye review carries the reference sentence; shot sentences are stored on the shots themselves."""
    r = load_review(slug)
    return {"reference": r.get("reference"), "shots": {}}


def fr_num(v, nd: int = 2) -> str:
    if v is None:
        return "non mesuré"
    return f"{v:.{nd}f}".replace(".", ",")


def auto_description(s: dict) -> str:
    """Fallback sentence from the measures alone, used until a human description exists."""
    fam = FAMILY_FR[s["family"]]
    cam = ", ".join(s["camera"]["kind"])
    bg = s["roles"].get("background", "")
    parts = [f"Plan {fam} sur un fond dominant {bg}"]
    if s["text_lines"]:
        parts.append(f"{len(s['text_lines'])} ligne(s) de texte mesurée(s)")
    if s["elements"]:
        parts.append(f"{len(s['elements'])} élément(s) animé(s) suivi(s)")
    parts.append(f"mouvement global : {cam}")
    return ", ".join(parts) + " (description automatique)."


def description(s: dict, desc: dict) -> str:
    return s.get("description") or desc.get("shots", {}).get(s["id"]) or auto_description(s)


def shot_moves(s: dict) -> list[str]:
    out = []
    for ch, row in s["camera"].get("channels", {}).items():
        for tw in row.get("moves", []):
            out.append(f"image {ch} {tw['ease']} ({fr_num(tw['duration'])} s)")
    for el in s["elements"]:
        for ch, tws in el["channels"].items():
            for tw in tws:
                out.append(f"{el['id']} {ch} {tw['ease']} ({fr_num(tw['duration'])} s)")
    return out


