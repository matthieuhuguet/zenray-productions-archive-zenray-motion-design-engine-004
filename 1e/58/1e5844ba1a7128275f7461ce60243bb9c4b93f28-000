# 12 October 2026, 10:05 CEST: cook a motion's params.json into a self-contained HyperFrames project.
# Contract (docs/research/R01 section 15): one paused GSAP timeline registered last as window.__timelines.main;
# every time is an integer frame in params and frame/fps (6 decimals) in HTML; fromTo with explicit end states;
# local fonts and GSAP only; one project per version and format. The params are the only truth: this file is
# a build product, never edited by hand.
from __future__ import annotations

import html
import json
import shutil
from pathlib import Path

from .. import settings

REPO = settings.REPO
VENDOR = REPO / "vendor"
CSS_PROPS = {"x": "x", "y": "y", "scale": "scale", "scaleX": "scaleX", "scaleY": "scaleY", "rotation": "rotation",
             "opacity": "opacity", "blur": "--zr-blur", "shine": "--zr-shine", "shineW": "--zr-shine-w", "shineA": "--zr-shine-a", "letterSpacing": "letterSpacing", "brightness": "--zr-bright"}


def _t(frame: int | float, fps: float) -> str:
    return f"{frame / fps:.6f}"


def _layer_html(layer: dict, fps: float, frames_total: int) -> str:
    lid = layer["id"]
    start, end = layer.get("start_frame", 0), layer.get("end_frame", frames_total)
    attrs = f'id="{lid}" class="clip layer layer-{layer["type"]}" data-start="{_t(start, fps)}"'
    if end is not None:
        attrs += f' data-duration="{_t(end - start, fps)}"'
    attrs += f' data-track-index="{layer.get("track", 1)}"'
    if layer["type"] == "text":
        return f'<div {attrs}><span class="ink">{html.escape(layer["text"])}</span></div>'
    if layer["type"] in ("solid", "gradient", "shape"):
        return f'<div {attrs}></div>'
    if layer["type"] == "grid":
        return f'<canvas {attrs} width="{layer["data"]["cols"]}" height="{layer["data"]["rows"]}"></canvas>'
    if layer["type"] == "field":
        w, h = layer.get("canvas", [960, 540])
        return f'<canvas {attrs} width="{w}" height="{h}"></canvas>'
    if layer["type"] == "image":
        return f'<div {attrs}><img src="{html.escape(layer["src"])}" alt="" /></div>'
    raise ValueError(f"unknown layer type {layer['type']}")


def _layer_css(layer: dict) -> str:
    lid = layer["id"]
    base = [f"#{lid} {{ position: absolute; z-index: {layer.get('z', 1)};"]
    if layer["type"] == "solid":
        base.append(f" inset: 0; background: {layer['color']};")
    elif layer["type"] == "field":
        base.append(" left: 0; top: 0; width: 100%; height: 100%;")
    elif layer["type"] == "grid":
        base.append(" left: 0; top: 0; width: 100%; height: 100%; image-rendering: auto;")
    elif layer["type"] == "gradient":
        base.append(f" inset: 0; background: {layer['css']};")
    elif layer["type"] == "shape":
        x, y, w, h = layer["box"]
        base.append(f" left: {x}px; top: {y}px; width: {w}px; height: {h}px; background: {layer['fill']};"
                    f" border-radius: {layer.get('radius', 0)}px;")
    elif layer["type"] in ("text", "image"):
        ax, ay = layer.get("anchor", [0.5, 0.5])
        base.append(f" left: {layer['x']}px; top: {layer['y']}px; transform-origin: {ax * 100}% {ay * 100}%;"
                    f" translate: {-ax * 100}% {-ay * 100}%; white-space: nowrap;")
    if layer["type"] == "text":
        f = layer["font"]
        base.append(f" font-family: '{f['family']}'; font-weight: {f.get('weight', 400)}; font-size: {f['size']}px;"
                    f" line-height: 1; letter-spacing: {f.get('tracking', 0)}em; color: {layer['color']};"
                    f" font-variation-settings: {f.get('variation', 'normal')};")
    if layer["type"] == "text" and layer.get("lightmap"):
        base.append(" color: transparent; -webkit-background-clip: text; background-clip: text;")
    shine = layer.get("shine")
    if layer["type"] == "text" and shine and not layer.get("lightmap"):
        # Highlight band clipped by the glyphs. --zr-shine: band centre (% of layer width); --zr-shine-w: half width (%);
        # --zr-shine-a: highlight mix 0..1. All three are animated from measured curves.
        peak = f"color-mix(in srgb, {shine['highlight']} calc(var(--zr-shine-a, 0) * 100%), {shine['base']})"
        c = "var(--zr-shine, -999)"; w = "var(--zr-shine-w, 10)"
        base.append(f" color: transparent; background-image: linear-gradient(90deg, {shine['base']} 0%, {shine['base']} calc(({c} - {w}) * 1%),"
                    f" {peak} calc({c} * 1%), {shine['base']} calc(({c} + {w}) * 1%), {shine['base']} 100%);"
                    " -webkit-background-clip: text; background-clip: text;")
    base.append(" filter: blur(calc(var(--zr-blur, 0) * 1px)) brightness(var(--zr-bright, 1)); will-change: transform, opacity; }")
    initial = layer.get("initial", {})
    if initial:
        props = "; ".join(f"{('--zr-blur' if k == 'blur' else '--zr-bright' if k == 'brightness' else k)}: {v}" for k, v in initial.items()
                          if k in ("opacity", "blur", "brightness"))
        if props:
            base.append(f"\n#{lid} {{ {props}; }}")
    return "".join(base)


def _tweens_js(layer: dict, fps: float) -> list[str]:
    lines = []
    for prop, tweens in layer.get("tracks", {}).items():
        key = CSS_PROPS[prop]
        if tweens:
            # Hold the first value before the first tween starts (the state at frame 0 is explicit).
            lines.append(f'  tl.set("#{layer["id"]}", {{{json.dumps(key)}: {json.dumps(tweens[0]["from"])}}}, 0);')
        for tw in tweens:
            unit = "" if prop in ("opacity", "scale", "scaleX", "scaleY", "blur", "brightness", "shine", "shineW", "shineA") else ("em" if prop == "letterSpacing" else "")
            frm = json.dumps(tw["from"]) if not unit else json.dumps(f"{tw['from']}{unit}")
            to = json.dumps(tw["to"]) if not unit else json.dumps(f"{tw['to']}{unit}")
            ease = tw.get("ease", "none")
            if ease.startswith("cubic-bezier"):
                ease = f"CustomBezier:{ease}"
            lines.append(f'  Z.tween(tl, "#{layer["id"]}", {json.dumps(key)}, {frm}, {to}, {_t(tw["start_frame"], fps)}, '
                         f'{_t(tw["frames"], fps)}, {json.dumps(ease)});')
    return lines


RUNTIME = r"""// 12 October 2026: tiny runtime shared by every cooked motion. Pure functions of time, no clocks.
window.Z = (function () {
  function bezier(x1, y1, x2, y2) {
    return function (t) {
      let s = t;
      for (let i = 0; i < 12; i++) {
        const x = 3 * (1 - s) * (1 - s) * s * x1 + 3 * (1 - s) * s * s * x2 + s * s * s - t;
        const dx = 3 * (1 - s) * (1 - s) * x1 + 6 * (1 - s) * s * (x2 - x1) + 3 * s * s * (1 - x2);
        s = Math.min(1, Math.max(0, s - x / (Math.abs(dx) < 1e-6 ? 1e-6 : dx)));
      }
      return 3 * (1 - s) * (1 - s) * s * y1 + 3 * (1 - s) * s * s * y2 + s * s * s;
    };
  }
  function ease(name) {
    if (name.startsWith("CustomBezier:")) {
      const n = name.slice(13).replace("cubic-bezier(", "").replace(")", "").split(",").map(Number);
      return bezier(n[0], n[1], n[2], n[3]);
    }
    return name;
  }
  function tween(tl, sel, prop, from, to, at, dur, easeName) {
    const a = {}, b = { duration: Math.max(dur, 1e-6), ease: ease(easeName), immediateRender: false };
    a[prop] = from; b[prop] = to;
    tl.fromTo(sel, a, b, at);
  }
  return { tween: tween };
})();
"""


FIELD_RUNTIME = r"""// 12 October 2026: measured polar colour field drawn on a canvas, a pure function of the frame index.
Z.field = function (tl, sel, data, fps, frames, controls) {
  // Procedural controls on top of the measured data (HDA interface): scale, speed, offset_frames, shape
  // {blend 0..1 towards a superellipse of exponent n and aspect}, and a CSS colour filter (hue, saturate, brightness).
  const C = Object.assign({ scale: 1, speed: 1, offset_frames: 0, shape: { blend: 0, n: 2, aspect: 1 }, hue: 0, saturate: 1, brightness: 1 }, controls || {});
  C.shape = Object.assign({ blend: 0, n: 2, aspect: 1 }, C.shape || {});
  const canvas = document.querySelector(sel);
  canvas.style.filter = `hue-rotate(${C.hue}deg) saturate(${C.saturate}) brightness(${C.brightness})`;
  const ctx = canvas.getContext("2d");
  const W = canvas.width, H = canvas.height, k = W / 1920;
  const edges = data.rho_edges, nT = data.n_theta, S = data.samples, track = data.track;
  const mids = edges.slice(0, -1).map((e, i) => (e + edges[i + 1]) / 2);
  function sampleAt(f) {
    let a = S[0], b = S[S.length - 1];
    for (let i = 0; i < S.length - 1; i++) { if (S[i].frame <= f && S[i + 1].frame >= f) { a = S[i]; b = S[i + 1]; break; } }
    const u = b.frame === a.frame ? 0 : Math.min(1, Math.max(0, (f - a.frame) / (b.frame - a.frame)));
    return { a: a.field, b: b.field, ca: a.cart, cb: b.cart, u: u };
  }
  function colour(fa, fb, u, rho, th) {
    let i = 0; while (i < mids.length - 1 && mids[i + 1] < rho) i++;
    const j = Math.min(mids.length - 1, i + 1);
    const v = j === i ? 0 : Math.min(1, Math.max(0, (rho - mids[i]) / (mids[j] - mids[i])));
    const t = th * nT - 0.5, t0 = ((Math.floor(t) % nT) + nT) % nT, t1 = (t0 + 1) % nT, w = t - Math.floor(t);
    const out = [0, 0, 0];
    for (let c = 0; c < 3; c++) {
      const g = (f) => (f[i][t0][c] * (1 - w) + f[i][t1][c] * w) * (1 - v) + (f[j][t0][c] * (1 - w) + f[j][t1][c] * w) * v;
      out[c] = g(fa) * (1 - u) + g(fb) * u;
    }
    return out;
  }
  const nC = data.n_cart || 0, rimLo = (data.rim || 0.9) - 0.03, rimHi = (data.rim || 0.9) + 0.02;
  function cart(fa, fb, u, x, y) {
    const gx = (x + 1) / 2 * nC - 0.5, gy = (y + 1) / 2 * nC - 0.5;
    const x0 = Math.max(0, Math.min(nC - 1, Math.floor(gx))), y0 = Math.max(0, Math.min(nC - 1, Math.floor(gy)));
    const x1 = Math.min(nC - 1, x0 + 1), y1 = Math.min(nC - 1, y0 + 1);
    const wx = Math.min(1, Math.max(0, gx - x0)), wy = Math.min(1, Math.max(0, gy - y0));
    const out = [0, 0, 0];
    for (let c = 0; c < 3; c++) {
      const g = (f) => (f[y0][x0][c] * (1 - wx) + f[y0][x1][c] * wx) * (1 - wy) + (f[y1][x0][c] * (1 - wx) + f[y1][x1][c] * wx) * wy;
      out[c] = g(fa) * (1 - u) + g(fb) * u;
    }
    return out;
  }
  function superellipse(th, R) {
    // Radius of a superellipse |x/a|^n + |y/b|^n = 1 at angle th (a = R * aspect, b = R).
    const a = R * C.shape.aspect, b = R, n = C.shape.n, c = Math.abs(Math.cos(th)), s = Math.abs(Math.sin(th));
    return 1 / Math.pow(Math.pow(c / a, n) + Math.pow(s / b, n), 1 / n);
  }
  function draw(fIn) {
    const f = (fIn - C.offset_frames) * C.speed;
    const tr0 = track[Math.min(track.length - 1, Math.max(0, Math.round(f)))];
    const tr = tr0 ? Object.assign({}, tr0, { r: tr0.r * C.scale, profile: tr0.profile ? tr0.profile.map((v, i) => {
      const th = (i + 0.5) / tr0.profile.length * 2 * Math.PI - Math.PI;
      return (v * (1 - C.shape.blend) + superellipse(th, tr0.r) * C.shape.blend) * C.scale;
    }) : null }) : null;
    ctx.clearRect(0, 0, W, H);
    if (!tr || tr.r < 2) return;
    const s = sampleAt(f), img = ctx.createImageData(W, H), cx = tr.cx * k, cy = tr.cy * k;
    const R = (tr.profile ? Math.max.apply(null, tr.profile) : tr.r) * k;
    const x0 = Math.max(0, Math.floor(cx - R - 1)), x1 = Math.min(W, Math.ceil(cx + R + 1));
    const y0 = Math.max(0, Math.floor(cy - R - 1)), y1 = Math.min(H, Math.ceil(cy + R + 1));
    for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) {
      const dx = x + 0.5 - cx, dy = y + 0.5 - cy, d = Math.sqrt(dx * dx + dy * dy);
      const th = (Math.atan2(dy, dx) + Math.PI) / (2 * Math.PI);
      let Rt = R;
      if (tr.profile) {
        const n = tr.profile.length, q = th * n - 0.5, i0 = ((Math.floor(q) % n) + n) % n, i1 = (i0 + 1) % n, ww = q - Math.floor(q);
        Rt = (tr.profile[i0] * (1 - ww) + tr.profile[i1] * ww) * k;
      }
      const rho = d / Rt;
      if (rho > 1.0 + 1 / Rt) continue;
      let c = colour(s.a, s.b, s.u, Math.min(rho, 0.999), th);
      if (s.ca && rho < rimHi) {
        const rr = tr.r * k, q = cart(s.ca, s.cb, s.u, dx / rr, dy / rr), m = rho < rimLo ? 1 : (rimHi - rho) / (rimHi - rimLo);
        c = [c[0] * (1 - m) + q[0] * m, c[1] * (1 - m) + q[1] * m, c[2] * (1 - m) + q[2] * m];
      }
      const alpha = Math.min(1, Math.max(0, (Rt - d) + 0.5));
      const o = (y * W + x) * 4; img.data[o] = c[0]; img.data[o + 1] = c[1]; img.data[o + 2] = c[2]; img.data[o + 3] = 255 * alpha;
    }
    ctx.putImageData(img, 0, 0);
    if (tr.spot && tr.spot.r * k > 0.3) {
      ctx.beginPath();
      ctx.arc(cx + tr.spot.dx * k, cy + tr.spot.dy * k, tr.spot.r * k, 0, 2 * Math.PI);
      ctx.fillStyle = `rgb(${tr.spot.color.map(Math.round).join(",")})`;
      ctx.fill();
    }
  }
  const proxy = { f: 0 };
  tl.to(proxy, { f: frames, duration: frames / fps, ease: "none", onUpdate: () => draw(proxy.f) }, 0);
  draw(0);
};
"""


GRID_RUNTIME = r"""// 12 October 2026: low-resolution colour grid of a plate (grade, light, mass motion), upscaled smoothly.
// Controls: offset_frames, speed, brightness, saturate, hue (CSS filter).
Z.grid = function (tl, sel, data, fps, frames, controls) {
  const C = Object.assign({ offset_frames: 0, speed: 1, brightness: 1, saturate: 1, hue: 0 }, controls || {});
  const canvas = document.querySelector(sel), ctx = canvas.getContext("2d"), W = data.cols, H = data.rows;
  canvas.style.filter = `hue-rotate(${C.hue}deg) saturate(${C.saturate}) brightness(${C.brightness})`;
  function draw(fIn) {
    const f = Math.max(0, (fIn - C.offset_frames) * C.speed), q = f / data.step;
    const i0 = Math.min(data.grid.length - 1, Math.floor(q)), i1 = Math.min(data.grid.length - 1, i0 + 1), u = Math.min(1, q - Math.floor(q));
    const a = data.grid[i0], b = data.grid[i1], img = ctx.createImageData(W, H);
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
      const o = (y * W + x) * 4;
      for (let c = 0; c < 3; c++) img.data[o + c] = a[y][x][c] * (1 - u) + b[y][x][c] * u;
      img.data[o + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
  }
  const proxy = { f: 0 };
  tl.to(proxy, { f: frames, duration: frames / fps, ease: "none", onUpdate: () => draw(proxy.f) }, 0);
  draw(0);
};
"""


LIGHTMAP_RUNTIME = r"""// 12 October 2026: measured light on text (slices across the text x frames), a pure function of the frame.
Z.lightmap = function (tl, sel, data, fps, frames) {
  const el = document.querySelector(sel), B = data.bins, base = data.base, gain = data.gain || 1, off = data.offset_frames || 0;
  function draw(f) {
    const i = Math.min(data.rel.length - 1, Math.max(0, Math.round(f - off - (data.start_frame || 0))));
    const row = data.rel[i], stops = [];
    for (let k = 0; k < B; k++) {
      // Below 1 the light is transparency (a caption fading in over a picture), above 1 it brightens the ink.
      const m = row[k] * gain, alpha = Math.max(0, Math.min(1, m)), lift = Math.max(1, m);
      const c = base.map((v) => Math.max(0, Math.min(255, Math.round(v * lift))));
      stops.push(`rgba(${c[0]},${c[1]},${c[2]},${alpha.toFixed(3)}) ${((k + 0.5) / B * 100).toFixed(2)}%`);
    }
    el.style.backgroundImage = `linear-gradient(90deg, ${stops.join(", ")})`;
  }
  const proxy = { f: 0 };
  tl.to(proxy, { f: frames, duration: frames / fps, ease: "none", onUpdate: () => draw(proxy.f) }, 0);
  draw(0);
};
"""


def cook(params: dict, out_dir: str | Path, fmt: str = "16x9") -> Path:
    """Write <out_dir>/<fmt>/ as a HyperFrames project. Returns the project folder."""
    canvas = params["canvas"]
    w, h, fps, frames = canvas["width"], canvas["height"], canvas["fps"], canvas["frames"]
    project = Path(out_dir) / fmt
    if project.exists():
        shutil.rmtree(project)
    (project / "vendor").mkdir(parents=True)
    (project / "assets" / "fonts").mkdir(parents=True)
    shutil.copy(VENDOR / "gsap.min.js", project / "vendor" / "gsap.min.js")
    font_faces = []
    for face in params.get("fonts", []):
        src = Path(face["file"])
        shutil.copy(src, project / "assets" / "fonts" / src.name)
        font_faces.append(f"@font-face {{ font-family: '{face['family']}'; src: url('assets/fonts/{src.name}');"
                          f" font-weight: {face.get('weights', '100 900')}; font-display: block; }}")
    layers = params["layers"]
    audio = params.get("audio", [])
    for track in audio:
        src = Path(track["file"])
        (project / "assets" / "audio").mkdir(parents=True, exist_ok=True)
        shutil.copy(src, project / "assets" / "audio" / src.name)
        track["src"] = f"assets/audio/{src.name}"
    body = "\n    ".join(_layer_html(l, fps, frames) for l in layers)
    audio_html = "\n    ".join(
        f'<audio id="{a["id"]}" src="{a["src"]}" data-start="0" data-duration="{_t(frames, fps)}" data-volume="{a.get("volume", 1)}"'
        + (' data-timeline-role="music"' if a.get("role") == "music" else "") + "></audio>" for a in audio)
    css = "\n".join(font_faces + [
        "html, body { margin: 0; padding: 0; background: #000; }",
        f"#root {{ position: relative; width: {w}px; height: {h}px; overflow: hidden; isolation: isolate; }}",
    ] + [_layer_css(l) for l in layers])
    js = [RUNTIME, FIELD_RUNTIME, LIGHTMAP_RUNTIME, GRID_RUNTIME, "(function () {", "  const tl = gsap.timeline({ paused: true });"]
    for l in layers:
        js += _tweens_js(l, fps)
        if l["type"] == "text" and l.get("lightmap"):
            js.append(f'  Z.lightmap(tl, "#{l["id"]}", {json.dumps(l["lightmap"], separators=(",", ":"))}, {fps}, {frames});')
        if l["type"] == "grid":
            js.append(f'  Z.grid(tl, "#{l["id"]}", {json.dumps(l["data"], separators=(",", ":"))}, {fps}, {frames}, {json.dumps(l.get("controls", {}))});')
        if l["type"] == "field":
            js.append(f'  Z.field(tl, "#{l["id"]}", {json.dumps(l["data"], separators=(",", ":"))}, {fps}, {frames}, {json.dumps(l.get("controls", {}))});')
    js += ["  window.__timelines = window.__timelines || {};", '  window.__timelines["main"] = tl;', "})();"]
    (project / "styles.css").write_text(css + "\n", encoding="utf-8")
    (project / "hyperframes.json").write_text(json.dumps({"$schema": "https://hyperframes.heygen.com/schema/hyperframes.json",
                                                         "paths": {"assets": "assets"}}, indent=2) + "\n", encoding="utf-8")
    page = f"""<!doctype html>
<!-- Cooked by zrmd from params.json (12 October 2026); never edit by hand. -->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width={w}, height={h}" />
  <link rel="stylesheet" href="styles.css" />
  <script src="vendor/gsap.min.js"></script>
</head>
<body>
  <div id="root" data-composition-id="main" data-start="0" data-duration="{_t(frames, fps)}" data-width="{w}" data-height="{h}" data-fps="{fps}">
    {body}
    {audio_html}
  </div>
  <script>
{chr(10).join(js)}
  </script>
</body>
</html>
"""
    (project / "index.html").write_text(page, encoding="utf-8")
    return project
