# ---------------------------------------------------------------- shared context (12 October 2026)

def critic():
    """The M3 critic module loaded read-only from Scripts/MusicCritic.py. FR : le critique M3, en lecture seule."""
    spec = importlib.util.spec_from_file_location("music_critic_ro", ROOT / "Scripts" / "MusicCritic.py")
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def context(base_version: str = "V_034") -> dict:
    P = RS.params()
    sr = P["sampleRate"]
    bench = Path(P["paths"]["bench"])
    prm = json.loads((bench / base_version / "params.json").read_text())
    score = json.loads((bench / base_version / "score.json").read_text())
    ref_st = RS._read(Path(P["paths"]["stems"]) / "other.wav", sr)
    return {"P": P, "sr": sr, "bench": bench, "prm": prm, "score": score, "refStereo": ref_st, "ref": RS.mono(ref_st),
            "n": prm["lengthSamples"]}


def seeds_of(prm: dict, P: dict, roles=None) -> dict:
    """Base roles keep the seed of resynth.render; extra roles (duration split, 12 October 2026) get seedBase + 100 + i."""
    order = sorted(prm["voices"])
    roles = list(roles or ROLES)
    return {r: P["render"]["seedBase"] + (order.index(r) if r in order else 100 + i) for i, r in enumerate(roles)}


def base_role(r: str) -> str:
    return r[:-5] if r.endswith("Short") else r


# ---------------------------------------------------------------- render of the stem (12 October 2026)

def render_dry(voices: dict, notes: dict, P: dict, n: int, seeds: dict) -> np.ndarray:
    """Sum of the three tonal voices, mono, no effects. FR : rendu sec des trois voix."""
    x = np.zeros(n, np.float32)
    for r in notes:
        if notes.get(r) and not voices[r].get("mute"):
            x += sms.render_role(voices[r], notes[r], P, n, seeds[r], 0.0)
    return x


def apply_fx(dry: np.ndarray, fx: dict, score: dict, P: dict, n: int, stages: dict | None = None) -> np.ndarray:
    """Residual bed, per-bar eq and automation exactly as resynth.render does for the stem (mono, before stereo)."""
    st = {"residual": True, "eq": True, "automation": True, **(stages or {})}
    sr = P["sampleRate"]
    if fx.get("residualP") or fx.get("automationP"):  # 12 October 2026: residual and automation settings of this candidate
        P = RS.merge(copy.deepcopy(P), {"residual": fx.get("residualP") or {}, "automation": fx.get("automationP") or {}})
    au = score["automation"]
    t0 = score["tempo"]["t0"]
    x = dry_shaped(dry, fx, sr)
    if st["residual"] and fx.get("residual"):
        lane = au["stems"].get("other") if au.get("stems") else None
        seed = P["render"]["seedBase"] + 500 + RS.STEMS.index("other")
        if fx.get("bed"):  # 13 October 2026: steady sine-cloud bed (render_residual_steady) instead of random-phase noise
            x = x + render_residual_steady(fx["residual"], n, sr, P, lane, au["hopS"], seed, fx["bed"], t0)
        else:
            x = x + RS.render_residual(fx["residual"], n, sr, P, lane, au["hopS"], seed, 1.0, t0)
    if st["eq"] and fx.get("eq"):
        Pe = P if fx.get("rampS") is None else RS.merge(copy.deepcopy(P), {"eq": {"rampS": fx["rampS"]}})
        x = RS.apply_eq(x, fx["eq"], sr, Pe, 1.0, t0)
    if st["automation"] and fx.get("automation") and au["stems"].get("other"):
        xc = fx.get("automationCrossoverHz")
        if xc:  # 13 October 2026: gain riding above a crossover only; the low band keeps its own (eq) level
            from scipy.signal import butter, sosfiltfilt
            lo = sosfiltfilt(butter(4, xc, "low", fs=sr, output="sos"), x).astype(np.float32)
            x = lo + RS.apply_automation(x - lo, au["stems"]["other"], au["hopS"], au["windowS"], sr, P)
        else:
            x = RS.apply_automation(x, au["stems"]["other"], au["hopS"], au["windowS"], sr, P)
    if st.get("eqPost", True) and fx.get("eqPost"):  # 12 October 2026: second eq after the automation (dB domain)
        Pe = P if fx.get("rampS") is None else RS.merge(copy.deepcopy(P), {"eq": {"rampS": fx["rampS"]}})
        x = RS.apply_eq(x, fx["eqPost"], sr, Pe, 1.0, t0)
    return x


# 13 October 2026: settings of the steady residual bed (the interface). FR : reglages du lit de residu stable.
BED_STEADY = {"_doc": "13 October 2026: residual bed rebuilt as a cloud of fixed sines (one every spacingBins bins of an "
                      "nFft grid, frequency jittered by up to jitterBins of a bin, random phase) whose amplitudes follow "
                      "the measured band table and the lane, instead of random-phase STFT noise. A random bed adds its own "
                      "frame-to-frame power scatter on top of the reference's; a steady bed only carries the table level.",
              "nFft": 4096, "spacingBins": 3, "jitterBins": 0.25, "fMinHz": 20.0, "chunk": 4096, "levelDb": -6.02}  # levelDb: measured gap to resynth.render_residual on a flat table (13 October 2026: -6.0 to -6.2 dB above 150 Hz), so marginDb keeps its meaning


def render_residual_steady(res: dict, n: int, sr: int, P: dict, lane: list | None, hop_s: float, seed: int,
                           B: dict | None = None, t0: float = 0.0) -> np.ndarray:
    """13 October 2026: same table and lane as resynth.render_residual, synthesised additively. Sine k carries the power
    of spacingBins bins of the measurement grid: a white noise of per-bin power p over spacingBins bins equals a sine of
    amplitude sqrt(4 * M * p / (N * sum(w^2))), M bins of the N-point grid per sine (Parseval on the windowed frame).
    FR : meme table et meme enveloppe, rendues par un nuage de sinus fixes au lieu d'un bruit a phase aleatoire."""
    B = {**BED_STEADY, **(B if isinstance(B, dict) else {})}
    R = P["residual"]
    nf, hop = res["nFft"], res["hop"]
    frames = n // hop + 1
    times = np.arange(frames) * hop / sr
    rng = np.random.default_rng(seed)
    df = sr / B["nFft"]
    k = np.arange(int(B["fMinHz"] / df) + 1, int(0.5 * sr / df) - 2, B["spacingBins"]).astype(np.float64)
    f = (k + rng.uniform(-B["jitterBins"], B["jitterBins"], len(k))) * df
    ph = rng.uniform(0, 2 * np.pi, len(k))
    lc, lf = np.log2(res["centresHz"]), np.log2(f)
    Pw = np.zeros((len(f), frames))
    for sec in res["sections"]:
        m = (times >= sec["start"]) & (times < sec["end"])
        if m.any():
            Pw[:, m] = (10 ** (np.interp(lf, lc, sec["bandsDb"]) / 10.0))[:, None]
    if lane is not None and R["followLane"]:
        lv = np.asarray(lane, np.float64)
        g = np.interp(times, np.arange(len(lv)) * hop_s, lv)
        for sec in res["sections"]:
            m = (times >= sec["start"]) & (times < sec["end"])
            if m.any():
                lin = 10 ** (g[m] / 10.0)
                Pw[:, m] *= (lin / (lin.mean() + 1e-30))[None, :]
    w = np.hanning(nf + 1)[:-1]
    # Per-bin power of the measurement grid (nFft nf) to sine amplitude, with spacingBins bins of the sine grid (B nFft).
    spacing_hz = B["spacingBins"] * df
    bins_per_sine = spacing_hz / (sr / nf)
    A = np.sqrt(4.0 * bins_per_sine * Pw / (nf * (w ** 2).sum())) * 10 ** (B["levelDb"] / 20.0)
    y = np.zeros(n, np.float64)
    fr_s = np.arange(frames) * hop
    for a in range(0, n, B["chunk"]):
        b = min(n, a + B["chunk"])
        t = np.arange(a, b)
        # amplitude envelopes interpolated per sine at the chunk's samples (linear between table frames)
        idx = np.clip(np.searchsorted(fr_s, t) - 1, 0, frames - 2)
        u = (t - fr_s[idx]) / hop
        amp = A[:, idx] * (1 - u)[None, :] + A[:, idx + 1] * u[None, :]
        y[a:b] = (amp * np.cos(ph[:, None] + 2 * np.pi * f[:, None] * (t / sr)[None, :])).sum(axis=0)
    return y.astype(np.float32)


def dry_shaped(dry: np.ndarray, fx: dict, sr: int) -> np.ndarray:
    """13 October 2026: optional zero-phase high-pass of the tonal render (fx.dryHighpassHz): below it the stem is left
    to the steady bed, whose level is the measured table, instead of tonal partials that beat on their own.
    FR : passe-haut optionnel du rendu tonal, le grave est laisse au lit stable."""
    hp = fx.get("dryHighpassHz")
    if not hp:
        return dry.copy()
    from scipy.signal import butter, sosfiltfilt
    return sosfiltfilt(butter(4, hp, "high", fs=sr, output="sos"), dry).astype(np.float32)


def notes_from_score(score: dict) -> dict:
    return {r: [dict(nn) for nn in score["voices"].get(r, {}).get("notes", [])] for r in ROLES}


def tf_score(ref: np.ndarray, ours: np.ndarray, sr: int, C=None) -> float:
    C = C or critic()
    return float(C.compare(ref, ours, sr)["score"])


# ---------------------------------------------------------------- fitting of timbres and fx (12 October 2026)

def fit_timbres(notes: dict, ctx: dict, dev: bool = True, dev_resume: bool = False, rounds: int | None = None,
                calib_rounds: int | None = None, P_over: dict | None = None) -> tuple[dict, dict, dict]:
    """sms tables for the three voices (analyse_stem), then per-note dev tables (eventdev.fit_stem).
    Returns (voices, notes with dev, info). FR : tables de timbre puis ecarts par note."""
    from .. import eventdev
    P = RS.merge(copy.deepcopy(ctx["P"]), P_over or {})
    for r in notes:  # 12 October 2026: a split role inherits its register role's analysis settings
        if r != base_role(r) and base_role(r) in P["sms"]["roleSettings"]:
            P["sms"]["roleSettings"].setdefault(r, dict(P["sms"]["roleSettings"][base_role(r)]))
    if calib_rounds is not None:
        P["sms"].setdefault("calibrationRoundsByStem", {})["other"] = calib_rounds
    ev = {r: [dict(nn, i=j) for j, nn in enumerate(notes[r])] for r in notes if notes.get(r)}
    if not dev_resume:
        for r in ev:
            for e in ev[r]:
                e.pop("dev", None)
    job = {"stem": "other", "P": P, "x": ctx["ref"], "events": ev, "kinds": {r: "tonal" for r in ev}}
    res = sms.analyse_stem(job)
    voices = copy.deepcopy(ctx["prm"]["voices"])
    for r, sp in res["specs"].items():
        voices[r] = sp
    info = {"calibration": res["calibration"]}
    if dev:
        if rounds is not None:
            P["eventDev"].setdefault("stemSettings", {}).setdefault("other", {})["rounds"] = rounds
        if dev_resume:
            P["eventDev"]["resume"] = True
        dj = {"stem": "other", "P": P, "x": ctx["ref"], "n": ctx["n"], "events": ev, "specs": {r: voices[r] for r in ev},
              "seeds": seeds_of(ctx["prm"], P, list(ev))}
        dres = eventdev.fit_stem(dj)
        info["dev"] = dres["history"]
        for r, rows in dres["events"].items():
            for e, row in zip(ev[r], rows):
                e["dev"] = row["dev"]
    out = {r: [{k: v for k, v in e.items() if k != "i"} for e in ev.get(r, [])] for r in notes}
    return voices, out, info


FX_SPAN_RAMP_S = {"bar": None, "half": 0.1, "beat": 0.05}  # 12 October 2026: eq crossfade per span size


def fx_spans(score: dict, P: dict, kind: str) -> list:
    """12 October 2026: spans of the residual and eq tables: bar (as resynth), half bar or beat (the musical grid;
    measured on V_001: bar 95.66, half 95.98, beat 96.37). Never finer than a beat: below the grid a table per span
    would turn into a vocoder of the reference. FR : spans du residu et de l'egaliseur, jamais plus fin que le temps."""
    if kind == "bar":
        return RS.fx_spans(score, P)
    bt = [b["t"] for b in score["tempo"]["beats"]]
    if kind == "half":
        bt = bt[::2]
    ed = [0.0] + bt + [score["tempo"]["duration"]]
    return [(a, b) for a, b in zip(ed[:-1], ed[1:]) if b - a > 0.05]


EQ_DB = {"nFft": 4096, "hop": 1024, "floorDb": 60.0, "maxDb": 24.0}  # 12 October 2026: dB-domain eq settings


def measure_eq_db(ref: np.ndarray, ours: np.ndarray, spans: list, sr: int, P: dict, E: dict | None = None) -> dict:
    """12 October 2026: per-span third-octave eq measured in the dB domain: the weighted median over frames of
    (reference dB - ours dB), weights max(ref, ours) above a floor 60 dB under the reference peak (as the critic weighs
    its error). resynth.measure_eq matches mean POWER, which leaves an on-off note pattern under in dB over most frames;
    the median of the dB difference minimises the mean absolute dB error instead (measured on V_008: 96.81 to 97.08,
    and 97.19 with the second pass after the automation). Same table format as resynth.measure_eq.
    FR : egaliseur mesure en dB (mediane ponderee de l'ecart par trame), au lieu du rapport des puissances moyennes."""
    import librosa
    E = {**EQ_DB, **(E or {})}
    c = RS.band_centres(P, sr)
    W = RS._band_weights(np.fft.rfftfreq(E["nFft"], 1.0 / sr), c)

    def bdb(x):
        return 10 * np.log10(W @ (np.abs(librosa.stft(np.asarray(x, np.float32), n_fft=E["nFft"], hop_length=E["hop"])) ** 2) + 1e-20)
    m = min(len(ref), len(ours))
    r, o = bdb(ref[:m]), bdb(ours[:m])
    fl = r.max() - E["floorDb"]
    r2, o2 = np.maximum(r, fl), np.maximum(o, fl)
    w = np.maximum(r2, o2) - fl
    dd = r2 - o2
    times = np.arange(r.shape[1]) * E["hop"] / sr
    rows = []
    for a, b in spans:
        fm = (times >= a) & (times < b)
        g = np.zeros(len(c))
        if fm.any():
            for i in range(len(c)):
                ww, v = w[i, fm], dd[i, fm]
                if ww.sum() <= 0:
                    continue
                o_ = np.argsort(v)
                cw = np.cumsum(ww[o_])
                g[i] = v[o_][min(len(v) - 1, int(np.searchsorted(cw, 0.5 * cw[-1])))]
        rows.append({"start": round(a, 4), "end": round(b, 4), "gainsDb": [round(float(q), 2) for q in np.clip(g, -E["maxDb"], E["maxDb"])]})
    return {"centresHz": [round(float(q), 2) for q in c], "sections": rows, "mode": "dbMedian"}


def fit_fx(dry: np.ndarray, ctx: dict, score: dict, span: str = "bar", eq_mode: str = "power", eq_post: bool = False,
           residual_margin_db: float | None = None, automation_smooth: int | None = None, bed=None,
           automation_crossover_hz: float | None = None, dry_highpass_hz: float | None = None) -> dict:
    """Residual bed measured on the dry stem, then the eq on dry plus bed, automation and stereo, as
    ResynthMusic.fit_stem_fx does for every stem; span = bar, half or beat. FR : residu, egaliseur, automation, stereo."""
    P, sr, n = ctx["P"], ctx["sr"], ctx["n"]
    res_p = None
    if residual_margin_db is not None:
        # 12 October 2026: a bed larger than the measured deficit (marginDb < 0) leaves a noise floor under the notes
        # that the dB eq then levels; measured on V_017: 0 dB 97.40, -3 dB 97.72, -6 dB 97.75, -10 dB 97.76.
        # FR : un lit de bruit plus fort que le manque mesure, nivele ensuite par l'egaliseur en dB.
        res_p = {"marginDb": float(residual_margin_db)}
        P = RS.merge(copy.deepcopy(P), {"residual": res_p})
    spans = fx_spans(score, P, span)
    pre = {"dryHighpassHz": float(dry_highpass_hz)} if dry_highpass_hz else {}
    fx = {**pre, "residual": RS.measure_residual(ctx["ref"], dry_shaped(dry, pre, sr), spans, sr, P, P["residual"].get("sectionGateDb", {}).get("other")),
          "automation": True, "span": span, "rampS": FX_SPAN_RAMP_S[span]}
    if res_p:
        fx["residualP"] = res_p
    if automation_crossover_hz:  # 13 October 2026: see apply_fx
        fx["automationCrossoverHz"] = float(automation_crossover_hz)
    if bed:  # 13 October 2026: steady sine-cloud bed (True or a dict over BED_STEADY)
        fx["bed"] = {"mode": "steady", **(bed if isinstance(bed, dict) else {})}
    if automation_smooth is not None:
        # 12 October 2026: gain riding without smoothing follows the 50 ms lane closer (V_018: 2 frames 97.75, 1 frame
        # 97.89, 4 frames 97.71). FR : automation sans lissage.
        fx["automationP"] = {"smoothFrames": int(automation_smooth)}
    bed = apply_fx(dry, fx, score, P, n, {"eq": False, "automation": False})
    fx["eq"] = measure_eq_db(ctx["ref"], bed, spans, sr, P) if eq_mode == "db" else RS.measure_eq(ctx["ref"], bed, spans, sr, P)
    if fx["rampS"] is None:
        fx.pop("rampS")
    if eq_post:
        x = apply_fx(dry, fx, score, P, n)
        fx["eqPost"] = measure_eq_db(ctx["ref"], x, spans, sr, P)
    fx["stereo"] = RS.measure_stereo(ctx["refStereo"], sr, P)
    return fx


# ---------------------------------------------------------------- transcription (12 October 2026)
# CQT of the reference stem; per-register templates learned from isolated notes (frames where one pitch dominates the
# harmonic NMF of transcribe.py by isoDb and holds for isoMinMs), averaged on a pitch-relative axis and shifted to every
# MIDI pitch of the register (shift-invariant source-filter view); NMF with those templates fixed plus a few free noise
# components (KL multiplicative updates); note tracking with hysteresis; onset-aligned retiming on the stem's detected
# onsets; pyin on the monophonic segments refines pitch and cents. Numbers only.
# FR : transcription par NMF sur CQT a gabarits appris sur des notes isolees, pyin sur les segments monophoniques,
# recalage des attaques sur les attaques detectees de la piste.

