def _db(a, floor=-120.0):
    return np.maximum(20 * np.log10(np.maximum(np.asarray(a, np.float64), 1e-12)), floor)


def _cqt(x: np.ndarray, sr: int, T: dict) -> tuple[np.ndarray, float]:
    import librosa
    fmin = float(librosa.note_to_hz(T["fminNote"]))
    n_bins = T["binsPerOctave"] * T["octaves"]
    V = np.abs(librosa.cqt(np.asarray(x, np.float32), sr=sr, hop_length=T["hop"], fmin=fmin, n_bins=n_bins,
                           bins_per_octave=T["binsPerOctave"]))
    t = np.arange(int(sr * 1.0)) / sr
    C = np.abs(librosa.cqt(np.sin(2 * np.pi * 440.0 * t).astype(np.float32), sr=sr, hop_length=T["hop"], fmin=fmin,
                           n_bins=n_bins, bins_per_octave=T["binsPerOctave"]))
    calib = float(C[:, C.shape[1] // 4: 3 * C.shape[1] // 4].max(axis=0).mean())  # peak bin of a unit sine
    return V, calib


def _harmonic_dict(T: dict, pitches: list[int]) -> np.ndarray:
    import librosa
    bpo = T["binsPerOctave"]
    nb = bpo * T["octaves"]
    m0 = librosa.note_to_midi(T["fminNote"])
    b = np.arange(nb)
    W = np.zeros((nb, len(pitches)))
    for j, p in enumerate(pitches):
        for h in range(1, 11):
            c = (p - m0) * bpo / 12.0 + bpo * math.log2(h)
            if c > nb - 1:
                break
            g = np.exp(-0.5 * ((b - c) / 0.8) ** 2)
            g[np.abs(b - c) > 1.5] = 0.0
            W[:, j] += h ** -0.8 * g
    return W / (W.sum(axis=0, keepdims=True) + 1e-12)


def _nmf(V: np.ndarray, W: np.ndarray, n_fixed: int, iters: int, sparsity: float, seed: int = 0) -> tuple[np.ndarray, np.ndarray]:
    """KL multiplicative updates; the first n_fixed columns of W stay fixed (learned templates), the rest are free."""
    rng = np.random.default_rng(seed)
    W = W.copy()
    H = np.full((W.shape[1], V.shape[1]), float(V.mean()) + 1e-9) * (0.5 + rng.random((W.shape[1], 1)))
    eps = 1e-12
    for _ in range(iters):
        R = V / (W @ H + eps)
        H *= (W.T @ R) / (W.sum(axis=0)[:, None] + sparsity + eps)
        if W.shape[1] > n_fixed:
            R = V / (W @ H + eps)
            Wf = W[:, n_fixed:]
            Wf *= (R @ H[n_fixed:].T) / (H[n_fixed:].sum(axis=1)[None, :] + eps)
            s = Wf.sum(axis=0, keepdims=True) + eps
            Wf /= s
            H[n_fixed:] *= s.T
            W[:, n_fixed:] = Wf
    return W, H


def learn_templates(V: np.ndarray, T: dict) -> tuple[np.ndarray, list[int], dict]:
    """Per-register spectral templates from isolated notes. Isolated frame: the harmonic NMF activation of one pitch is
    at least isoDb above every other pitch that is not its octave or twelfth ghost, for isoMinMs in a row. The CQT
    frame (normalised) is read on a pitch-relative axis (bin 0 = fundamental); the median per register is the
    template, shifted to every pitch of the register. FR : gabarits par registre appris sur les trames isolees."""
    import librosa
    bpo = T["binsPerOctave"]
    nb = V.shape[0]
    m0 = librosa.note_to_midi(T["fminNote"])
    pitches = list(range(T["minMidi"], T["maxMidi"] + 1))
    W0 = _harmonic_dict(T, pitches)
    _, H = _nmf(V, np.concatenate([W0, np.ones((nb, 1)) / nb], axis=1), len(pitches), 60, 0.0)
    A = _db(H[:len(pitches)])
    order = np.argsort(-A, axis=0)
    top, second = order[0], order[1]
    gap = A[top, np.arange(A.shape[1])] - A[second, np.arange(A.shape[1])]
    # a second pitch an octave, twelfth or two octaves above the top does not break isolation
    iv = np.asarray(pitches)[second] - np.asarray(pitches)[top]
    third = A[order[2], np.arange(A.shape[1])]
    gap = np.where(np.isin(iv, [12, 19, 24]), A[top, np.arange(A.shape[1])] - third, gap)
    loud = A[top, np.arange(A.shape[1])] >= A.max() - 40.0
    iso = (gap >= T["isoDb"]) & loud
    min_f = max(1, int(T["isoMinMs"] / 1000.0 * T.get("sr", 44100) / T["hop"]))
    frames = []
    i = 0
    n = len(iso)
    while i < n:
        if iso[i]:
            j = i
            while j < n and iso[j] and top[j] == top[i]:
                j += 1
            if j - i >= min_f:
                frames += [(k, pitches[top[i]]) for k in range(i, j)]
            i = j
        else:
            i += 1
    L = T["templateBins"]
    regs: dict = {}
    for k, p in frames:
        f0b = int(round((p - m0) * bpo / 12.0))
        col = V[f0b: f0b + L, k]
        if len(col) < bpo:
            continue
        col = np.pad(col, (0, L - len(col)), constant_values=np.nan)
        col = col / (np.nansum(col) + 1e-12)
        regs.setdefault((p - T["minMidi"]) // (12 * T["registerOct"]), []).append(col)
    tmpl = {}
    for r, cols in regs.items():
        if len(cols) >= T["isoMinFrames"]:
            tmpl[r] = np.nan_to_num(np.nanmedian(np.asarray(cols), axis=0), nan=0.0)
    W = np.zeros((nb, len(pitches)))
    used = {}
    for j, p in enumerate(pitches):
        r = (p - T["minMidi"]) // (12 * T["registerOct"])
        if not tmpl:
            W[:, j] = W0[:, j]
            used[p] = "harmonic"
            continue
        rr = min(tmpl, key=lambda q: abs(q - r))
        f0b = int(round((p - m0) * bpo / 12.0))
        k = min(L, nb - f0b)
        W[f0b:f0b + k, j] = tmpl[rr][:k]
        if T["templateMask"] == "harmonic":
            # 12 October 2026: keep only the learned amplitudes at harmonic positions (h * f0 within maskBins): a frame
            # called isolated inside a chord still carries its neighbours at +4 and +7 semitones, and an unmasked
            # template then explains a whole chord with one pitch (selftest). FR : gabarit masque aux harmoniques.
            rel = np.arange(nb)[:, None] - f0b - bpo * np.log2(np.arange(1, T["maskHarmonics"] + 1))[None, :]
            W[:, j] *= (np.abs(rel).min(axis=1) <= T["maskBins"])
        # 12 October 2026: below the fundamental a template is zero (a learned frame there holds neighbours, not the note)
        used[p] = f"register{rr}"
    W /= W.sum(axis=0, keepdims=True) + 1e-12
    info = {"isolatedFrames": len(frames), "registers": {int(r): len(c) for r, c in regs.items()}, "learned": sorted(int(r) for r in tmpl)}
    return W, pitches, info


def track_notes(V: np.ndarray, W: np.ndarray, pitches: list[int], calib: float, onsets: np.ndarray, sr: int, T: dict) -> tuple[list[dict], dict]:
    from scipy import signal
    k = len(pitches)
    nb = V.shape[0]
    if T["noiseMode"] == "free":
        rng = np.random.default_rng(3)
        Wn = rng.random((nb, T["noiseComponents"]))
        Wn /= Wn.sum(axis=0, keepdims=True)
        Wf, H = _nmf(V, np.concatenate([W, Wn], axis=1), k, T["iterations"], T["sparsity"])
    else:
        # 12 October 2026: fixed smooth noise components (wide Gaussians on the bin axis): free ones learn harmonic
        # shapes and steal notes (selftest noise share 0.52, recall 0.18). FR : bruit lisse fixe, il ne vole plus les notes.
        b = np.arange(nb)[:, None]
        cen = np.linspace(0, nb - 1, T["noiseComponents"])[None, :]
        Wn = np.exp(-0.5 * ((b - cen) / (nb / T["noiseComponents"])) ** 2)
        Wn /= Wn.sum(axis=0, keepdims=True)
        Wf, H = _nmf(V, np.concatenate([W, Wn], axis=1), k + T["noiseComponents"], T["iterations"], T["sparsity"])
    A = H[:k] / calib
    if T["medianFrames"] > 1:
        A = signal.medfilt(A, kernel_size=[1, T["medianFrames"]])
    Adb = _db(A)
    top = float(Adb.max())
    Adb = np.where(Adb >= Adb.max(axis=0, keepdims=True) - T["frameRelDb"], Adb, -120.0)
    hop_s = T["hop"] / sr
    on_thr, off_thr = top - T["onDbBelowMax"], top - T["offDbBelowMax"]
    min_f = max(1, int(T["minNoteMs"] / 1000 / hop_s))
    win = max(1, int(T["splitWindowMs"] / 1000 / hop_s))
    match = T["onsetMatchMs"] / 1000.0
    raw = []
    for j in range(k):
        a = Adb[j]
        active, start = False, 0
        for i in range(len(a) + 1):
            v = a[i] if i < len(a) else -999.0
            if not active and v >= on_thr:
                active, start = True, i
            elif active and v < off_thr:
                active = False
                if i - start >= min_f:
                    raw.append([j, start, i])
            elif active and i - start >= max(min_f, 2 * win) and v - a[max(start, i - win):i].min() >= T["splitRiseDb"] \
                    and onsets.size and np.min(np.abs(onsets - i * hop_s)) <= match and a[i - 1] < v:
                raw.append([j, start, i])
                start = i
    import librosa
    m0 = librosa.note_to_midi(T["fminNote"])
    Vdb = _db(V / calib)
    out = []
    for j, a, b in raw:
        fb = int(round((pitches[j] - m0) * T["binsPerOctave"] / 12.0))
        f_db = float(np.median(Vdb[max(0, fb - 1):fb + 2, a:b].max(axis=0)))
        if f_db < float(Adb[j, a:b].max()) + T["fundamentalMinDb"]:
            continue
        out.append({"t": a * hop_s, "dur": (b - a) * hop_s, "midi": int(pitches[j]),
                    "levelDb": round(float(Adb[j, a:b].max()) + T["levelOffsetDb"], 2), "_a": a, "_b": b})
    keep = []
    for n1 in out:
        ghost = False
        for n0 in out:
            if n1 is n0:
                continue
            iv = n1["midi"] - n0["midi"]
            if iv in T["ghostIntervals"]:
                need = T["ghostDb"]
            elif abs(iv) in T["neighborIntervals"]:
                need = T["neighborDb"]
            else:
                continue
            ov = min(n1["_b"], n0["_b"]) - max(n1["_a"], n0["_a"])
            if ov >= 0.8 * (n1["_b"] - n1["_a"]) and n0["levelDb"] - n1["levelDb"] >= need:
                ghost = True
                break
        if not ghost:
            keep.append(n1)
    for n_ in keep:
        n_.pop("_a")
        n_.pop("_b")
    noise = float((Wf[:, k:] @ H[k:]).sum() / ((Wf @ H).sum() + 1e-12))
    return keep, {"rawNotes": len(raw), "notes": len(keep), "noiseShare": round(noise, 4)}


def retime(notes: list[dict], onsets: np.ndarray, T: dict) -> int:
    """Onset-aligned retiming: each note start moves to the nearest detected onset of the stem within retimeMaxMs;
    with endAlign the end keeps its time (the duration absorbs the move). Returns the count moved."""
    moved = 0
    if not onsets.size:
        return 0
    for n_ in notes:
        d = onsets - n_["t"]
        i = int(np.argmin(np.abs(d)))
        if abs(d[i]) <= T["retimeMaxMs"] / 1000.0 and abs(d[i]) > 1e-4:
            end = n_["t"] + n_["dur"]
            n_["t"] = float(onsets[i])
            if T["endAlign"]:
                n_["dur"] = max(0.03, end - n_["t"])
            moved += 1
    return moved


def pyin_refine(x: np.ndarray, sr: int, notes: list[dict], T: dict) -> dict:
    """pyin on the monophonic segments: a note that overlaps no other note for at least pyinMinMs gets the median
    pyin pitch of its confident frames; within pyinMaxSemi of the transcribed pitch it sets midi and cents.
    FR : pyin sur les segments monophoniques."""
    import librosa
    srt = sorted(notes, key=lambda q: q["t"])
    changed, tried = 0, 0
    for n_ in srt:
        a, b = n_["t"], n_["t"] + n_["dur"]
        solo_a, solo_b = a, b
        for o in srt:
            if o is n_:
                continue
            oa, ob = o["t"], o["t"] + o["dur"]
            if ob <= a or oa >= b:
                continue
            # cut the solo span to the part not covered by o
            if oa <= solo_a:
                solo_a = max(solo_a, ob)
            elif ob >= solo_b:
                solo_b = min(solo_b, oa)
            else:
                solo_b = min(solo_b, oa)
        if solo_b - solo_a < T["pyinMinMs"] / 1000.0:
            continue
        tried += 1
        f = sms.midi_hz(n_["midi"])
        seg = x[int(solo_a * sr): int(solo_b * sr)].astype(np.float32)
        if len(seg) < T["pyinFrame"]:
            continue
        f0, _v, prob = librosa.pyin(seg, fmin=f * 2 ** (-2 / 12), fmax=f * 2 ** (2 / 12), sr=sr,
                                    frame_length=T["pyinFrame"], hop_length=T["pyinHop"])
        ok = np.isfinite(f0) & (prob >= T["pyinProb"])
        if ok.sum() < 3:
            continue
        m = float(np.median(12 * np.log2(f0[ok] / 440.0) + 69))
        if abs(m - n_["midi"]) <= T["pyinMaxSemi"]:
            n_["cents"] = round(100 * (m - n_["midi"]), 1)
            changed += 1
        elif abs(m - round(m)) < 0.3 and abs(round(m) - n_["midi"]) == 1:
            n_["midi"] = int(round(m))
            n_["cents"] = round(100 * (m - n_["midi"]), 1)
            changed += 1
    return {"tried": tried, "changed": changed}


def transcribe_other(x: np.ndarray, sr: int, T: dict) -> tuple[dict, dict]:
    """The whole re-transcription: returns ({role: notes}, info)."""
    import librosa
    harm = librosa.effects.harmonic(np.asarray(x, np.float32), margin=T["hpssMargin"]) if T["hpssMargin"] else x
    V, calib = _cqt(harm, sr, T)
    env = librosa.onset.onset_strength(y=np.asarray(x, np.float32), sr=sr, hop_length=T["hop"])
    onsets = librosa.onset.onset_detect(onset_envelope=env, sr=sr, hop_length=T["hop"], units="time", delta=T["onsetDelta"], backtrack=True)
    W, pitches, tinfo = learn_templates(V, {**T, "sr": sr})
    notes, ninfo = track_notes(V, W, pitches, calib, onsets, sr, T)
    moved = retime(notes, onsets, T) if T["retime"] else 0
    pinfo = pyin_refine(x, sr, notes, T) if T["pyin"] else {}
    for n_ in notes:
        n_["t"] = round(n_["t"], 5)
        n_["dur"] = round(n_["dur"], 5)
    edges = [-1] + list(T["voiceSplitsMidi"]) + [1000]
    roles = {r: [] for r in ROLES}
    for n_ in sorted(notes, key=lambda q: (q["t"], q["midi"])):
        for r, lo, hi in zip(ROLES, edges[:-1], edges[1:]):
            if lo < n_["midi"] <= hi:
                # 12 October 2026: optional duration split, short notes (plucks) get their own timbre table
                if T.get("durSplitS") and n_["dur"] < T["durSplitS"]:
                    roles.setdefault(r + "Short", []).append(n_)
                else:
                    roles[r].append(n_)
                break
    info = {"templates": tinfo, "tracking": ninfo, "onsets": int(len(onsets)), "retimed": moved, "pyin": pinfo,
            "perRole": {r: len(v) for r, v in roles.items()}}
    return roles, info
