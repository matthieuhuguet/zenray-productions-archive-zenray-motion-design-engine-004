# 12 October 2026: task M3, drum transcription gap fill. The critic of V_027 measures the drum stem 4.5 dB short in
# 120 to 500 Hz, concentrated in the intro and in 16.7 to 22.1 s, and an onset detector on the reference drum stem finds
# about 20 loud onsets more than 40 ms away from any transcribed hit (spaced by two beats from 5.9 s: an unwritten
# backbeat). This module adds those hits to the score by deterministic signal processing only: onset detection on the
# reference drum stem (librosa spectral flux), class by the nearest class centroid of short-window third-octave spectra
# measured at the existing hits (level-normalised log spectra), level by the energy offset to that class's median.
# The added hits carry "added": "gapfill" and go through the per-event deviation stage like every other hit.
# Settings: datasets/resynth-params.json, key "gapFill" (HDA interface).
# FR : comble les frappes de batterie oubliees par la transcription, par detection d'attaques et plus proche classe.
from __future__ import annotations

import numpy as np


def _spectra(x: np.ndarray, sr: int, times, G: dict) -> np.ndarray:
    """Log third-octave power of the window [t, t + winS] for every time. FR : spectre court en tiers d'octave."""
    n = int(G["winS"] * sr)
    nfft = 1 << int(np.ceil(np.log2(max(n, 64))))
    f = np.fft.rfftfreq(nfft, 1.0 / sr)
    c = G["fMin"] * 2 ** (np.arange(int(3 * np.log2(G["fMax"] / G["fMin"])) + 1) / 3.0)
    W = np.maximum(0.0, 1.0 - np.abs(np.log2(np.maximum(f, 1e-6))[None, :] - np.log2(c)[:, None]) * 3.0)
    win = np.hanning(n)
    out = []
    for t in times:
        a = int(round(t * sr))
        seg = x[max(0, a): a + n]
        seg = np.pad(seg, (0, n - len(seg)))
        S = np.abs(np.fft.rfft(seg * win, nfft)) ** 2
        out.append(10 * np.log10(W @ S + 1e-20))
    return np.asarray(out)


def fill(score: dict, x: np.ndarray, sr: int, G: dict) -> tuple[dict, list]:
    """Return a new score with the missing drum hits added, and the list of added hits. x: reference drum stem mono."""
    import librosa

    hits = score["drums"]
    ht = np.array([h["t"] for h in hits])
    on = librosa.onset.onset_detect(y=x.astype(np.float32), sr=sr, hop_length=G["hop"], units="time", backtrack=False)
    on = on + G["onsetLagS"]
    far = np.array([np.min(np.abs(ht - t)) for t in on]) > G["matchS"]
    cand = on[far]
    if not len(cand):
        return score, []
    Sh = _spectra(x, sr, ht, G)
    Sc = _spectra(x, sr, cand, G)
    eh, ec = Sh.max(1), Sc.max(1)
    peak = float(np.max(eh))
    classes = sorted({h["class"] for h in hits})
    cen, lvl, eng = {}, {}, {}
    for k in classes:
        m = np.array([h["class"] == k for h in hits])
        if m.sum() < G["minClassHits"]:
            continue
        cen[k] = np.median(Sh[m] - eh[m, None], axis=0)
        lvl[k] = float(np.median([h["levelDb"] for h, mm in zip(hits, m) if mm]))
        eng[k] = float(np.median(eh[m]))
    added = []
    for t, s, e in zip(cand, Sc, ec):
        if e < peak - G["minDb"]:
            continue
        d = {k: float(np.mean(np.abs((s - e) - v))) for k, v in cen.items()}
        k = min(d, key=d.get)
        how = "nearest"
        off = float(e) - eng[k]
        if d[k] > G["maxDistDb"]:
            # 12 October 2026: no class is close (the loud sub hits of V_027 sit 7 dB from every centroid); take the class
            # whose centroid peaks in the same band, level matched on that band; the per-event deviation then carves
            # the rest of the spectrum. FR : sinon la classe dont le pic est dans la meme bande.
            pk = int(np.argmax(s))
            near = [q for q, v in cen.items() if int(np.argmax(v)) == pk] or [q for q, v in cen.items() if abs(int(np.argmax(v)) - pk) <= G["peakBandTol"]]
            if not near or not G["fallbackByPeakBand"]:
                continue
            k = max(near, key=lambda q: eng[q])
            how = "peakBand"
            off = float(s[pk]) - float(np.median(Sh[[h["class"] == k for h in hits]][:, pk]))
        added.append({"t": round(float(t), 5), "class": k, "levelDb": round(lvl[k] + off, 2), "added": "gapfill",
                      "how": how, "distDb": round(d[k], 2)})
    s2 = dict(score)
    s2["drums"] = sorted([dict(h) for h in hits] + [dict(a) for a in added], key=lambda h: h["t"])
    s2["gapFillBy"] = "zrmd.audio.gapfill (12 October 2026)"
    return s2, added
