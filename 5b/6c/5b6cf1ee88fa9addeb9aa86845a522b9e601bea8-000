#!/usr/bin/env python3
# 12 October 2026: task M3, verifier of the drum retagging block (zrmd/audio/retag.py), proven both ways.
#   VerifyRetag.py [--sabotage]
# Green: on a synthetic known case (a 250 to 45 Hz kick sweep and a steady 100 Hz tom) only the tom moves, and both
# wrong thresholds (200 Hz, 30 Hz) fail that criterion. --sabotage runs the same check with the pitch band moved to
# 150 to 300 Hz (a broken detector): the check must turn red (exit 1). Exit 0 only when the check holds.
# FR : verificateur du reclassement grosse caisse vers tom, vert sur le cas connu, rouge sur un detecteur casse.
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from zrmd.audio import resynth as RS  # noqa: E402
from zrmd.audio import retag  # noqa: E402


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--sabotage", action="store_true")
    a = ap.parse_args()
    P = RS.params()
    R = dict(P["retag"])
    if a.sabotage:
        R["bandHz"] = [150.0, 300.0]
    res = retag.selftest(P["sampleRate"], R)
    print(json.dumps({"date": "12 October 2026", "sabotage": a.sabotage, **res}, indent=1))
    sys.exit(0 if res["pass"] else 1)


if __name__ == "__main__":
    main()
