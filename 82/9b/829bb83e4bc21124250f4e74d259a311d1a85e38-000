// 12 October 2026, 11:00 CEST: runs the zrmd command line (python -I -m zrmd.cli), the stable contract shared with the
// MCP server. Every command prints one JSON object; this module returns it with the exit code, or a named error.
// FR : lance la ligne de commande zrmd et rend son objet JSON avec le code de sortie.
import { spawn } from 'node:child_process'

/** The last top-level JSON object printed on stdout (the CLI prints exactly one, indented). */
export function parseCliJson(stdout) {
  const text = String(stdout || '').trim()
  if (!text) return null
  const start = text.startsWith('{') ? 0 : text.lastIndexOf('\n{') + 1
  try { return JSON.parse(text.slice(start)) } catch { return null }
}

export function createEngine(engine, { spawnImpl = spawn } = {}) {
  /** run(['iterate', id, '--set', 'k=v'], { timeoutMs, signal, onLine }) -> { code, json, stderr } */
  function run(args, { timeoutMs = engine.quickTimeoutMs, signal } = {}) {
    return new Promise((resolve, reject) => {
      const child = spawnImpl(engine.python, ['-I', '-m', 'zrmd.cli', ...args], {
        cwd: engine.root, env: { ...process.env, ...engine.env }, stdio: ['ignore', 'pipe', 'pipe'],
      })
      let stdout = '', stderr = '', settled = false
      const finish = (fn, value) => { if (!settled) { settled = true; clearTimeout(timer); signal?.removeEventListener?.('abort', onAbort); fn(value) } }
      const timer = setTimeout(() => { child.kill('SIGTERM'); finish(reject, Object.assign(new Error(`zrmd ${args[0]} timed out after ${timeoutMs} ms`), { code: 'engine-timeout' })) }, timeoutMs)
      const onAbort = () => { child.kill('SIGTERM'); finish(reject, Object.assign(new Error(`zrmd ${args[0]} cancelled`), { code: 'cancelled' })) }
      signal?.addEventListener?.('abort', onAbort, { once: true })
      child.stdout.on('data', (d) => { stdout += d })
      child.stderr.on('data', (d) => { stderr += d; if (stderr.length > 65536) stderr = stderr.slice(-65536) })
      child.on('error', (error) => finish(reject, Object.assign(new Error(`zrmd could not start: ${error.message}`), { code: 'engine-missing' })))
      child.on('close', (code) => finish(resolve, { code, json: parseCliJson(stdout), stderr: stderr.slice(-4000) }))
    })
  }

  /** Like run, but a non zero exit or a missing/negative JSON becomes an Error naming the cause. */
  async function call(args, options) {
    const result = await run(args, options)
    if (result.code === 0 && result.json?.ok) return result.json
    const message = result.json?.error || result.stderr.trim().split('\n').slice(-3).join(' ') || `zrmd ${args[0]} exited ${result.code}`
    throw Object.assign(new Error(message), { code: result.json?.code || 'engine-failed', exit: result.code })
  }

  return { run, call }
}
