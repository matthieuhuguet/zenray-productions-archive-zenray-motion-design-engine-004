// FR : lit config.json une fois ; un test peut passer sa propre configuration.
import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import path from 'node:path'

export const SERVICE_DIR = path.dirname(path.dirname(fileURLToPath(import.meta.url)))

/** The engine's montage root: ZRMD_PATH_MONTAGES in engine.env, else params/montage.json (one truth, shared with Python). */
export function montageRoot(engine) {
  return engine.env?.ZRMD_PATH_MONTAGES || JSON.parse(readFileSync(path.join(engine.root, 'params', 'montage.json'), 'utf8')).root
}

export function loadConfig(file = path.join(SERVICE_DIR, 'config.json')) {
  const config = JSON.parse(readFileSync(file, 'utf8'))
  Object.defineProperty(config.engine, 'montageRoot', { get() { return montageRoot(this) }, enumerable: false, configurable: true })
  return config
}
